PORT=3000

# Password for viewing messages at /admin?key=YOUR_KEY  (CHANGE THIS)
ADMIN_KEY=change-me-to-a-long-random-string

# Only needed if the website is hosted on a different domain than this server (else leave empty)
ALLOWED_ORIGIN=

# Optional: get every new message in your inbox (Gmail example: use an "App Password")
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
